{
  "rewrites": [
    { "source": "/api/(.*)",            "destination": "/api/index.py" },
    { "source": "/health",              "destination": "/api/index.py" },
    { "source": "/auth/(.*)",           "destination": "/api/index.py" },
    { "source": "/alarms(.*)",          "destination": "/api/index.py" },
    { "source": "/challenges(.*)",      "destination": "/api/index.py" },
    { "source": "/habits(.*)",          "destination": "/api/index.py" },
    { "source": "/scoring(.*)",         "destination": "/api/index.py" },
    { "source": "/analytics(.*)",       "destination": "/api/index.py" },
    { "source": "/achievements(.*)",    "destination": "/api/index.py" },
    { "source": "/recommendations(.*)", "destination": "/api/index.py" },
    { "source": "/notifications(.*)",   "destination": "/api/index.py" },
    { "source": "/reports(.*)",         "destination": "/api/index.py" },
    { "source": "/alarm-logs(.*)",      "destination": "/api/index.py" },
    { "source": "/coach(.*)",           "destination": "/api/index.py" },
    { "source": "/admin(.*)",           "destination": "/api/index.py" },
    { "source": "/user(.*)",            "destination": "/api/index.py" },
    { "source": "/debug(.*)",           "destination": "/api/index.py" },
    { "source": "/docs",                "destination": "/api/index.py" },
    { "source": "/openapi.json",        "destination": "/api/index.py" },
    { "source": "/dashboard",           "destination": "/dashboard.html" },
    { "source": "/login",               "destination": "/login.html" },
    { "source": "/challenge",           "destination": "/challenge.html" }
  ]
}
